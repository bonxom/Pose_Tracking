{
  "expo": {
    "name": "Pose Tracking",
    "slug": "pose-tracking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Splash.png",
    "scheme": "posetracking",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.group1.posetracking",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E6F4FE",
          "android": {
            "image": "./assets/images/Splash.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-video",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/voice_notification.wav",
            "./assets/sounds/sms_notification.wav"
          ],
          "defaultChannel": "push-voice"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57083ea0-65ae-4ab3-afe3-cee26fbf29ba"
      }
    },
    "owner": "hqianqs-team"
  }
}